# Leave DATABASE_URL unset locally to use PGlite (no setup, stored in .pglite/).
# On Vercel, adding Neon from the Storage tab sets this automatically.
# DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# GitHub sign-in. Unset locally = no login screen. Required in production.
# AUTH_SECRET=            # generate with: npx auth secret
# AUTH_GITHUB_ID=
# AUTH_GITHUB_SECRET=
# ALLOWED_LOGIN=AoiTechDev   # comma-separated GitHub usernames allowed in

# Local development only: skip the GitHub login, because the OAuth callback URL
# points at the deployed site, not localhost. Ignored when NODE_ENV=production,
# so this can never leave a deployment unprotected.
# AUTH_DISABLED=1
